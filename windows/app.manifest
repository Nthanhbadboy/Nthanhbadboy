<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded application manifest for PhysicsDraw.exe (resource type 24, id 1).

  The windowed host also calls SetProcessDpiAwarenessContext() at run time; declaring it
  here as well is what Windows actually trusts, and it keeps the OS from applying DPI
  virtualisation to the window. Namespaces and element order follow the manifest template
  documented under "Application Manifests" on learn.microsoft.com.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="Nthanhbadboy.OneLinePhysicsDraw"
      version="1.0.0.0"
      processorArchitecture="amd64" />
  <description>One-Line Physics Draw</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Packaged (MSIX) runs ignore this and always run as the invoking user. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2,PerMonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
